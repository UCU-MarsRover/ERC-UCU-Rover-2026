<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find rover_description)/urdf/properties.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/macros/inertia_macros.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/macros/rocker_assembly.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/macros/accessories.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/macros/stereo_camera.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/macros/lidar.xacro"/>

  <xacro:if value="$(arg mount_arm)">
    <xacro:include filename="$(find arm_description)/urdf/arm_macro.xacro"/>
  </xacro:if>

  <!-- ===================== MATERIALS ===================== -->
  <material name="blue_body">
    <color rgba="0.55 0.56 0.58 1"/>
  </material>
  <material name="grey_structure">
    <color rgba="0.55 0.56 0.58 1"/>
  </material>
  <material name="orange_mount">
    <color rgba="0.55 0.56 0.58 1"/>
  </material>
  <material name="dark_wheel">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <material name="red_axii">
    <color rgba="0.55 0.56 0.58 1"/>
  </material>
  <material name="beacon_light">
    <color rgba="0.9 0.35 0.05 1"/>
  </material>
  <material name="button_red">
    <color rgba="0.7 0.05 0.05 1"/>
  </material>

  <!-- ===================== BASE ===================== -->
  <link name="base_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Ground-projected frame -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_link_ground_height}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== SUSPENSION BASE AXII ===================== -->
  <link name="suspension_base_axii_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${axii_mass}"/>
      <xacro:box_inertia m="${axii_mass}" x="${axii_length}" y="${axii_width}" z="${axii_height}"/>
    </inertial>
    <visual>
      <origin xyz="0 -0.325 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://rover_description/meshes/suspension/central_axii.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red_axii"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${axii_length} ${axii_width} ${axii_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="suspension_base_axii_joint" type="fixed">
    <parent link="base_link"/>
    <child link="suspension_base_axii_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ===================== MAIN BODY ===================== -->
  <link name="main_body_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <xacro:box_inertia m="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="blue_body"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="main_body_joint" type="fixed">
    <parent link="suspension_base_axii_link"/>
    <child link="main_body_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ZED2i STEREO CAMERA ===================== -->
  <!-- Both the macro call and the joint are guarded: the joint's child link is
       created by the macro, so neither can stand without the other. -->
  <xacro:if value="$(arg use_stereo_camera)">
    <xacro:stereo_camera
      use_sim="$(arg use_sim)"
      simulate_rgb="$(arg stereo_camera_simulate_rgb)"
      simulate_depth="$(arg stereo_camera_simulate_depth)"
      simulate_imu="$(arg stereo_camera_simulate_imu)"
    />

    <joint name="zed2i_base_joint" type="fixed">
      <parent link="main_body_link"/>
      <child link="zed2i_camera_link"/>
      <origin xyz="${zed2i_x} ${zed2i_y} ${zed2i_z}" rpy="${zed2i_rx} ${zed2i_ry} ${zed2i_rz}"/>
    </joint>
  </xacro:if>

  <!-- ===================== RPLIDAR S2 ===================== -->
  <xacro:lidar
    use_sim="$(arg use_sim)"
    simulate_scan="$(arg lidar_simulate_scan)"
  />

  <joint name="laser_joint" type="fixed">
    <parent link="main_body_link"/>
    <child link="laser_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== ROCKERS + WHEELS ===================== -->
  <xacro:rocker_assembly side="l" y_sign="1"/>
  <xacro:rocker_assembly side="r" y_sign="-1"/>

  <!-- ===================== ACCESSORIES ===================== -->
  <xacro:towerlight_accessory suffix="l" y_sign="1"/>
  <xacro:towerlight_accessory suffix="r" y_sign="-1"/>
  <xacro:stop_button_accessory suffix="l" y_sign="1"/>
  <xacro:stop_button_accessory suffix="r" y_sign="-1"/>

  <!-- ===================== ARM (OPTIONAL) ===================== -->
  <!-- Placeholder mount pose; update once the real MR_ARM_ATT attachment
       point from CAD is known. -->
  <xacro:if value="$(arg mount_arm)">
    <xacro:indomitus_arm parent_link="main_body_link">
      <origin xyz="0.2 0 0.1" rpy="0 0 0"/>
    </xacro:indomitus_arm>
  </xacro:if>

</robot>