<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="end_effector" default="jaw"/>
  <xacro:arg name="sim" default="false"/>
  <xacro:arg name="can_interface" default="can0"/>
  <!-- When the arm is mounted into another robot's URDF (e.g. the rover, see
       rover_description's mount_arm arg) that outer URDF already adds its
       own single gz_ros2_control-system plugin covering every <ros2_control>
       block in the combined model. Set this to false in that case so the
       arm doesn't register a second, redundant controller_manager plugin
       for the same Gazebo model. Standalone arm sim (arm_sim) leaves this
       at the default so it keeps adding its own plugin as before. -->
  <xacro:arg name="standalone_gz_plugin" default="true"/>
  <!-- camera:=false drops the simulated camera sensor (the URDF link and
       frames stay). Camera rendering is the main real-time-factor cost
       when the GPU isn't doing the rendering. -->
  <xacro:arg name="camera" default="true"/>

  <xacro:macro name="indomitus_arm" params="parent_link *origin">

    <xacro:property name="mesh_path" value="package://arm_description/meshes"/>
    <xacro:property name="stl_scale" value="0.001 0.001 0.001"/>

    <material name="light_grey">
      <color rgba="0.7 0.7 0.7 1.0"/>
    </material>

    <xacro:macro name="dummy_inertia" params="mass">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </xacro:macro>

    <joint name="arm_mount_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent_link}"/>
      <child link="arm_mount_link"/>
    </joint>

    <link name="arm_mount_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_mount_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_mount_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="1.0"/>
    </link>

    <joint name="arm_mount_base_joint" type="revolute">
      <parent link="arm_mount_link"/>
      <child link="arm_base_link"/>
      <origin xyz="0.06 0 0.021" rpy="0 0 ${-pi/2}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_base_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_base_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_base_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="2.0"/>
    </link>

    <joint name="arm_base_shoulder_joint" type="revolute">
      <parent link="arm_base_link"/>
      <child link="arm_shoulder_link"/>
      <origin xyz="-0.040366 -0.000325 0.103" rpy="${pi/3} 0 ${-pi}"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-20*pi/18}" upper="${20*pi/18}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_shoulder_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_shoulder_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_shoulder_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="1.5"/>
    </link>

    <joint name="arm_shoulder_forearm_joint" type="revolute">
      <parent link="arm_shoulder_link"/>
      <child link="arm_forearm_link"/>
      <origin xyz="0 0.3 0" rpy="${5*pi/12} 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${-pi/2}" upper="${pi/2}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_forearm_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_forearm_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_forearm_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="1.0"/>
    </link>

    <joint name="arm_forearm_wrist_1_joint" type="revolute">
      <parent link="arm_forearm_link"/>
      <child link="arm_wrist_1_link"/>
      <origin xyz="-0.0173 0.3 0" rpy="0 ${pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-20*pi/18}" upper="${20*pi/18}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_wrist_1_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.5"/>
    </link>

    <joint name="arm_wrist_1_wrist_2_joint" type="revolute">
      <parent link="arm_wrist_1_link"/>
      <child link="arm_wrist_2_link"/>
      <origin xyz="0.0323 0 -0.035" rpy="${-pi/2} 0 ${pi/2}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-20*pi/18}" upper="${20*pi/18}" effort="100.0" velocity="1.0"/>
    </joint>

    <link name="arm_wrist_2_link">
      <visual>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <geometry><mesh filename="${mesh_path}/arm_wrist_v2.stl" scale="${stl_scale}"/></geometry>
      </collision>
      <xacro:dummy_inertia mass="0.3"/>
    </link>

    <joint name="arm_wrist_2_end_effector_joint" type="revolute">
      <parent link="arm_wrist_2_link"/>
      <child link="arm_end_effector_link"/>
      <origin xyz="0.0323 0 -0.035" rpy="${-pi/2} ${pi/3} ${-pi/2}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-20*pi/18}" upper="${20*pi/18}" effort="100.0" velocity="1.0"/>
    </joint>

    <!-- Drill/sample masses+centroids: STL divergence-theorem volumes (not
         vertex-avg, biased by triangle density), mass-weighted COM (density
         differs: drill ~14.6 g/cm^3, sample ~1.0), not drill_sampling.stl's
         own volumetric centroid — those are different points. Single source
         of truth for the drill_sampling tool COM: edit these three, both the
         gravity-comp <param>s below and the TEMP DEBUG VISUAL marker read
         from here. -->
    <xacro:property name="drill_ee_tool_com_x" value="-0.03"/>
    <xacro:property name="drill_ee_tool_com_y" value="-0.08"/>
    <xacro:property name="drill_ee_tool_com_z" value="0.05"/>

    <!-- astrobio, physically mounted, has no mesh/finger geometry of its
         own yet — reuses the jaw STL purely as a visual/collision stand-in
         (see the xacro:if just below) and the jaw gravity-comp defaults as
         a starting payload point, both by explicit request. CAN routing
         (end_effector_can_node.py) and this payload are otherwise fully
         separate from real jaw: 'astrobio' is its own end_effector value
         everywhere (safe CAN no-op — no firmware yet — see can_bus.md;
         its own poses.json "astrobio_home"; its own gravity-comp <param>
         override below in <ros2_control>, gated on 'astrobio' specifically
         so real jaw keeps using arm_hardware_interface.hpp's own tuned
         default, 0.4kg/{0,0,0.06}, untouched). COM not yet measured —
         starts at jaw's old default, tune against the TEMP DEBUG VISUAL
         marker below. astrobio has NO finger joints modeled (see the
         jaw-only xacro:if further below) — it shows as one rigid body,
         matching that there is nothing to open/close on the CAN side either. -->
    <xacro:property name="astrobio_ee_tool_mass_kg" value="0.4"/>
    <xacro:property name="astrobio_ee_tool_com_x" value="0.0"/>
    <xacro:property name="astrobio_ee_tool_com_y" value="0.0"/>
    <xacro:property name="astrobio_ee_tool_com_z" value="0.08"/>

    <link name="arm_end_effector_link">
      <xacro:if value="${('$(arg end_effector)' == 'jaw') or ('$(arg end_effector)' == 'astrobio')}">
        <visual>
          <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_v3.stl" scale="${stl_scale}"/></geometry>
          <material name="light_grey"/>
        </visual>
        <collision>
          <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_v3.stl" scale="${stl_scale}"/></geometry>
        </collision>
      </xacro:if>

      <xacro:if value="${'$(arg end_effector)' == 'other_tool'}">
      </xacro:if>

      <!-- rpy="0 pi pi/2" corrects the STL's misoriented assembly frame.
           ee_tool_com_{x,y,z} in <ros2_control> below is rotated to match
           (R=Rz(pi/2)*Ry(pi): x'=-y, y'=-x, z'=-z) — re-rotate both together. -->
      <xacro:if value="${'$(arg end_effector)' == 'drill_sampling'}">
        <visual>
          <origin xyz="0 0 0.01" rpy="0 ${pi} ${pi/2}"/>
          <geometry><mesh filename="${mesh_path}/drill_sampling.stl" scale="${stl_scale}"/></geometry>
          <material name="light_grey"/>
        </visual>
        <collision>
          <origin xyz="0 0 0.01" rpy="0 ${pi} ${pi/2}"/>
          <geometry><mesh filename="${mesh_path}/drill_sampling.stl" scale="${stl_scale}"/></geometry>
        </collision>
      </xacro:if>

      <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
        <xacro:dummy_inertia mass="0.2"/>
      </xacro:if>
      <xacro:if value="${'$(arg end_effector)' == 'drill_sampling'}">
        <xacro:dummy_inertia mass="2.6"/>
      </xacro:if>
      <xacro:if value="${'$(arg end_effector)' == 'other_tool'}">
        <xacro:dummy_inertia mass="0.2"/>
      </xacro:if>
      <!-- Matches astrobio_ee_tool_mass_kg above — keep in sync (this is
           the sim/RViz-facing inertial mass, that one the real gravity-comp
           payload; same number, two separate places by URDF/ros2_control's
           own design, not a bug). -->
      <xacro:if value="${'$(arg end_effector)' == 'astrobio'}">
        <xacro:dummy_inertia mass="${astrobio_ee_tool_mass_kg}"/>
      </xacro:if>
    </link>

    <!-- Deliberately gated on 'jaw' ONLY, not astrobio too: astrobio has no
         known finger/gripper mechanism (real hardware has no firmware for
         it yet — see can_bus.md), so it gets no prismatic finger joints and
         no gripper_right/left_controller (arm_bringup/arm.launch.py's own
         gripper spawner condition is 'jaw' only already). It shows as one
         rigid body reusing the jaw mesh above, nothing to open/close. -->
    <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
      <!-- v3: no CAD dimension doc available (unlike v2 above). Derived from
           the STL geometry itself: arm_jaw_gripper_finger_v3.stl is exported
           in the gripper's own assembly frame (same frame as
           arm_jaw_gripper_v3.stl), not in a per-part local frame like v2 was.
           Its bbox (X[-48.83,11] Y[-16.91,14.08] Z[53,161.52]mm) already sits
           correctly relative to the body bbox (Z[0,76]mm, overlap 53-76mm =
           mechanism recessed into the body, 76-161.5mm = fingers protruding)
           when placed with a plain identity origin. Stroke has no v3 source
           of truth yet, kept at the v2 value pending visual confirmation of
           open/close range in sim.

           finger_x_closed is NOT zero, unlike the rest: mirroring the mesh
           180 deg about Z at a plain (0,0,0) origin leaves the two finger
           surfaces apart at rest, so each side is shifted inward. 17.24mm
           brings the grasp band's tightest ridge (Z~130-163mm) to ~0 gap;
           the rest of that band stays open because the mesh is curved,
           not flat, there — pushing the offset further to close more of
           it makes the fingers visibly cross rather than sit closed.

           Collisions between the two finger links are excluded from each
           other via SDF collide_bitmask (gazebo reference blocks below):
           real Gazebo physics deadlocks the prismatic joint against its
           own contact force when their meshes overlap, and they only
           ever need to push against a grasped object, not each other. -->
      <xacro:property name="finger_x_closed" value="0.01724"/>
      <xacro:property name="finger_stroke" value="0.012"/>
      <!-- Small buffer past the real endpoints (0 and finger_stroke), wider
           than finger_stroke on purpose — see the finger declarations
           below for why. A/B/C-tested live (2026-08): padding only the
           command_interface with the physical <joint><limit> left tight
           did NOT fix the stuck-finger bug (gz_ros2_control had no effect
           — DART's own joint stop, from the physical limit, is what the
           finger was actually resting against); a small epsilon on the
           physical limit itself did. -->
      <xacro:property name="finger_limit_epsilon" value="0.002"/>
      <xacro:property name="finger_z" value="0.0"/>
      <xacro:property name="finger_right_y" value="0.0"/>
      <xacro:property name="finger_left_y" value="0.0"/>

      <xacro:macro name="jaw_gripper_finger" params="side x_closed y yaw axis_sign limit_lower limit_upper">
        <joint name="arm_jaw_gripper_finger_${side}_joint" type="prismatic">
          <parent link="arm_end_effector_link"/>
          <child link="arm_jaw_gripper_finger_${side}_link"/>
          <origin xyz="${x_closed} ${y} ${finger_z}" rpy="0 0 ${yaw}"/>
          <axis xyz="${axis_sign} 0 0"/>
          <limit lower="${limit_lower}" upper="${limit_upper}" effort="20.0" velocity="0.05"/>
          <!-- Left was a <mimic> of right until a live disturbance test
               (Gazebo Transport, bypassing ROS) caught DART's mimic
               constraint drifting out of sync and sticking, invisibly to
               ROS/RViz since a <mimic> joint has no state interface of
               its own. Left now has its own ros2_control interface below
               and is commanded in lockstep with right instead. -->
        </joint>

        <link name="arm_jaw_gripper_finger_${side}_link">
          <visual>
            <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_finger_v3.stl" scale="${stl_scale}"/></geometry>
            <material name="light_grey"/>
          </visual>
          <collision>
            <geometry><mesh filename="${mesh_path}/arm_jaw_gripper_finger_v3.stl" scale="${stl_scale}"/></geometry>
          </collision>
          <xacro:dummy_inertia mass="0.05"/>
        </link>
      </xacro:macro>

      <!-- Same part mounted twice: "left" is the "right" finger rotated 180 deg about Z,
           so both slide outward along their own local +X (axis) to open — no mirrored mesh needed.

           Both use finger_limit_epsilon padding past their real travel
           (right only ever commanded in [0, finger_stroke], left in
           [-finger_stroke, 0] — see keyboard_servo_node.py), because the
           0 rest position and the finger_stroke fully-open position are
           real endpoints a finger sits at continuously, and DART (Gazebo's
           physics engine) was found to sometimes silently ignore further
           position commands once a prismatic joint settles exactly on its
           own <limit> joint stop. See finger_limit_epsilon's declaration
           above for the A/B/C test that pinned this to the physical
           <limit>, not the command_interface bound. -->
      <xacro:jaw_gripper_finger side="right" x_closed="${finger_x_closed}"  y="${finger_right_y}" yaw="0"      axis_sign="-1" limit_lower="${-finger_limit_epsilon}" limit_upper="${finger_stroke + finger_limit_epsilon}"/>
      <xacro:jaw_gripper_finger side="left"  x_closed="${-finger_x_closed}" y="${finger_left_y}"  yaw="${pi}" axis_sign="1"  limit_lower="${-finger_stroke - finger_limit_epsilon}" limit_upper="${finger_limit_epsilon}"/>
    </xacro:if>

    <joint name="arm_tcp_joint" type="fixed">
      <parent link="arm_end_effector_link"/>
      <child link="arm_tcp_link"/>
      
      <xacro:if value="${('$(arg end_effector)' == 'jaw') or ('$(arg end_effector)' == 'drill_sampling') or ('$(arg end_effector)' == 'astrobio')}">
        <!-- v3: X=Y=0 by construction (right/left fingers are the same mesh
             mirrored 180 deg about Z through the shared origin, see the
             finger properties comment above, so that origin is the natural
             symmetric grasp centerline). Z = max Z of
             arm_jaw_gripper_finger_v3.stl (161.5187mm, fingertip reach in
             the shared assembly frame); same derivation the old v2 value
             used (finger_z + finger local Z max), simplified here since
             finger_z is now 0. This places the TCP at the fingertip
             plane, not the grasp center, ~46mm closer in (shorter reach)
             than v2's TCP (0.1615 vs 0.2072) — a correct consequence of
             v3's fingers being physically shorter than v2's, not a
             calculation error; the formula itself is unchanged from v2
             and matches the SRDF's own tip_link convention for
             arm_tcp_link (indomitus_arm.srdf).
             drill_sampling deliberately shares this same point/axis (drill
             mode rolls about arm_tcp_link's local Z). astrobio shares it
             too: it reuses the jaw mesh (no fingers of its own — see the
             xacro:if gating those, jaw-only), so its TCP is placed at the
             same fingertip point that mesh actually renders at. Revisit
             once astrobio has real geometry/reach of its own. -->
        <origin xyz="0 0 0.1615" rpy="0 0 0"/>
      </xacro:if>

      <xacro:if value="${('$(arg end_effector)' != 'jaw') and ('$(arg end_effector)' != 'drill_sampling') and ('$(arg end_effector)' != 'astrobio')}">
        <origin xyz="0 -0.23 0" rpy="0 0 0"/>
      </xacro:if>
    </joint>

    <link name="arm_tcp_link"/> 

    <joint name="arm_camera_joint" type="fixed">
      <parent link="arm_end_effector_link"/>
      <child link="arm_camera_link"/>
      <!-- Ground truth click on the mount recess: (2.47, 21.72, 23.86)mm
           surface point (see history above/git log for the RViz Publish
           Point capture). Y is offset from that surface point by the
           box's own half-extent along the axis that actually faces this
           direction: arm_camera_link's local Z maps to global -Y here (see
           the rpy below, unchanged throughout), and local Z is the box's
           HEIGHT dimension (third size number below); keep this offset
           at HALF THE CURRENT HEIGHT whenever that size number changes, or
           the box either gaps off the surface or buries into it. Currently
           0.05m tall -> 25mm half-extent -> Y = 21.72 + 25 = 46.72mm. -->
      <origin xyz="0.00247 0.04672 0.02386" rpy="0 ${-pi/2} ${pi/2}"/>
    </joint>

    <link name="arm_camera_link">
      <visual>
        <geometry>
          <box size="0.035 0.035 0.05"/>
        </geometry>
        <material name="camera_blue">
          <color rgba="0.0 0.0 1.0 1.0"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.035 0.035 0.05"/>
        </geometry>
      </collision>
    </link>

    <joint name="arm_camera_optical_joint" type="fixed">
      <parent link="arm_camera_link"/>
      <child link="arm_camera_optical_frame"/>
      <!-- 0.045 was sized for the old 60mm camera box (half-extent 30mm)
           and never revisited when the box shrank to 35mm; it put the
           lens 45mm out along camera_link's local +X (= +Z in
           arm_end_effector_link), landing deep inside the v3 gripper body
           instead of at the box's own front face. An actual captured
           /camera/image_raw frame confirmed this: flat solid grey, the lens
           pressed against the body's own material. Set to 0.0175, the
           current box's half-extent, so the lens sits flush with its front
           face instead of floating 27.5mm past it. rpy confirmed 180 deg
           rolled from a live captured frame (fingers rendered correctly
           shaped but upside down); flipping the sign of roll and yaw
           (pitch stays 0) is an exact 180 deg roll about the optical Z
           (viewing) axis: verified by matrix multiplication that the
           combined camera_joint*optical_joint rotation keeps the same +Z
           forward direction with X/Y both negated, not a re-aim.

           Verified against the Gazebo <sensor><pose> roll fix below with
           a live pixel-projection test (TF chain + camera K-matrix
           predicted a pixel that landed exactly on a known mesh point in
           a captured frame); the rotation is also quaternion-derived, so
           it cannot represent a reflection/X-inversion regardless. -->
      <origin xyz="0.0175 0 0" rpy="${pi/2} 0 ${pi/2}"/>
    </joint>

    <link name="arm_camera_optical_frame"/>

    <!-- TEMP DEBUG VISUAL — sanity-check the assumed tool COM against the
         real one by eye in RViz, one red ball per end_effector. Safe to
         delete this whole macro + xacro:if pair when done; not wired into
         collision (visual only). Each branch reads that tool's own
         *_ee_tool_com_x/y/z (declared above, also used by the gravity-comp
         <param>s in <ros2_control> below) — edit the properties, not this
         origin, and both stay in sync automatically. Only one xacro:if
         below is ever true for a given end_effector, so both are safe to
         emit the same joint/link name. -->
    <xacro:macro name="ee_tool_com_debug_marker" params="com_x com_y com_z">
      <joint name="arm_end_effector_com_debug_joint" type="fixed">
        <parent link="arm_end_effector_link"/>
        <child link="arm_end_effector_com_debug_link"/>
        <origin xyz="${com_x} ${com_y} ${com_z}" rpy="0 0 0"/>
      </joint>
      <link name="arm_end_effector_com_debug_link">
        <visual>
          <geometry><sphere radius="0.01"/></geometry>
          <material name="com_debug_red">
            <color rgba="1.0 0.0 0.0 1.0"/>
          </material>
        </visual>
      </link>
    </xacro:macro>

    <!-- No jaw branch here on purpose: real jaw's COM lives only in
         arm_hardware_interface.hpp's own C++ default (0.4kg/{0,0,0.06}),
         not exposed as an xacro property, so there is nothing for this
         marker to read for end_effector:=jaw. -->
    <xacro:if value="${'$(arg end_effector)' == 'astrobio'}">
      <xacro:ee_tool_com_debug_marker
        com_x="${astrobio_ee_tool_com_x}" com_y="${astrobio_ee_tool_com_y}" com_z="${astrobio_ee_tool_com_z}"/>
    </xacro:if>
    <xacro:if value="${'$(arg end_effector)' == 'drill_sampling'}">
      <xacro:ee_tool_com_debug_marker
        com_x="${drill_ee_tool_com_x}" com_y="${drill_ee_tool_com_y}" com_z="${drill_ee_tool_com_z}"/>
    </xacro:if>

    <ros2_control name="ArmSystem" type="system">
      <hardware>
        <xacro:if value="$(arg sim)">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="$(arg sim)">
          <xacro:if value="$(arg use_fake_hardware)">
            <plugin>mock_components/GenericSystem</plugin>
          </xacro:if>
          <xacro:unless value="$(arg use_fake_hardware)">
            <plugin>arm_hardware_interface/ArmCanSystem</plugin>
            <param name="can_interface">$(arg can_interface)</param>
            <!-- Stiffness ramps 0 -> 100% over this many seconds after activation -->
            <param name="gain_ramp_secs">15.0</param>
            <!-- Hard rate limiter on outgoing position commands (rad/s) —
                 even a wrong/hostile command can't move a joint faster than this. -->
            <param name="max_cmd_speed_rad_s">1.0</param>
            <!-- Activation aborts if any motor is silent for this long -->
            <param name="feedback_timeout_secs">2.0</param>
            <param name="gravity_ff_enabled">true</param>
            <!-- Set to each motor family's own real rated capacity, not the
                 shared MIT-protocol packing scale (48 Nm) — that scale is
                 NOT a safe ceiling for Damiao on its own: Damiao is only
                 rated 9 Nm continuous, so clamping it at the protocol's
                 48 Nm would let sustained gravity-holding torque run at
                 over 5x its continuous rating. Steadywin's 48 Nm here
                 already equals its own rated capacity, so this is the most
                 gravity-ff can use on either family without exceeding what
                 the motor itself can sustain indefinitely. -->
            <param name="gravity_ff_max_nm_steadywin">48.0</param>
            <param name="gravity_ff_max_nm_damiao">9.0</param>

            <!-- Payload mass + volumetric centroid (assembly frame, meters)
                 for gravity compensation — see arm_end_effector_link above
                 for how these were computed and cross-checked. jaw and
                 other_tool are left unset on purpose: ArmCanSystem's own
                 defaults (0.4 kg, {0,0,0.06}) are the real jaw tool's tuned
                 value from arm_hardware_interface.cpp — do not duplicate it
                 here. astrobio DOES get an explicit override below — see
                 astrobio_ee_tool_mass_kg/com_{x,y,z}'s own comment up at
                 arm_end_effector_link. -->
            <xacro:if value="${'$(arg end_effector)' == 'astrobio'}">
              <param name="ee_tool_mass_kg">${astrobio_ee_tool_mass_kg}</param>
              <param name="ee_tool_com_x">${astrobio_ee_tool_com_x}</param>
              <param name="ee_tool_com_y">${astrobio_ee_tool_com_y}</param>
              <param name="ee_tool_com_z">${astrobio_ee_tool_com_z}</param>
            </xacro:if>
            <xacro:if value="${'$(arg end_effector)' == 'drill_sampling'}">
              <!-- Mass-weighted COM of drill (2.0kg) + sample (0.6kg), raw-frame
                   value rotated to match the <origin rpy="0 pi pi/2"> above —
                   keep in sync if that changes. Values (drill_ee_tool_com_x/y/z
                   properties, declared up at arm_end_effector_link) have been
                   retuned repeatedly on explicit request after live testing
                   showed too much gravity-holding torque (arm drifting/
                   pushing up) — the original STL-derived value put the COM
                   much further out along the tool than the real assembly's.
                   Edit the xacro:property values, not these <param>s — the
                   TEMP DEBUG VISUAL marker above reads the same properties. -->
              <param name="ee_tool_mass_kg">2.8</param>
              <param name="ee_tool_com_x">${drill_ee_tool_com_x}</param>
              <param name="ee_tool_com_y">${drill_ee_tool_com_y}</param>
              <param name="ee_tool_com_z">${drill_ee_tool_com_z}</param>
            </xacro:if>
          </xacro:unless>
        </xacro:unless>
      </hardware>
      <!-- ======================= CALIBRATION =======================
           direction : +1 if pushing the joint in its URDF-positive direction
                       (right-hand rule about the <axis>) makes the RAW motor
                       angle increase; -1 otherwise.
           offset    : the RAW motor angle (rad) measured when the arm is
                       physically in the URDF zero pose. If you save the motor
                       zero (0xB1 / FF..FE) at that pose, offset = 0.0.
           kp / kd   : MIT gains, tuned on real hardware. The protocol packs
                       these into 12 bits over [0,500] and [0,5], and anything
                       above those is clamped silently — a kd of 6 reads back
                       as 5 with no warning anywhere.
           Re-verify with scripts/check_calibration.py (torqueless) after any
           mesh/geometry change that alters a joint's <axis>.
           ============================================================= -->
      <xacro:macro name="arm_joint_control" params="joint_name motor_id direction offset kp kd">
        <joint name="${joint_name}">
          <command_interface name="position">
            <param name="min">${-pi}</param>
            <param name="max">${pi}</param>
          </command_interface>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <param name="motor_id">${motor_id}</param>
          <param name="direction">${direction}</param>
          <param name="offset">${offset}</param>
          <param name="kp">${kp}</param>
          <param name="kd">${kd}</param>
        </joint>
      </xacro:macro>

      <!-- MIT gains: protocol max kp=500, kd=5. Steadywin at ceiling to hold
           gravity; Damiao a step below to reduce wrist oscillation while stiff. -->
      <xacro:arm_joint_control joint_name="arm_mount_base_joint"          motor_id="20" direction="-1" offset="0.0"  kp="500.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_base_shoulder_joint"       motor_id="21" direction="1"  offset="0.0"  kp="500.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_shoulder_forearm_joint"    motor_id="22" direction="-1" offset="0.0"  kp="500.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_forearm_wrist_1_joint"     motor_id="23" direction="-1" offset="0.0"  kp="400.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_wrist_1_wrist_2_joint"     motor_id="24" direction="-1" offset="0.0"  kp="400.0" kd="5.0"/>
      <xacro:arm_joint_control joint_name="arm_wrist_2_end_effector_joint" motor_id="25" direction="1"  offset="0.0"  kp="350.0" kd="5.0"/>

      <!-- Both fingers get their own interface — left used to be a bare
           <mimic> of right with no ros2_control entry, which made its real
           simulated state invisible to ROS (see the joint definition above
           for the full story of why that was dropped). Excluded on real
           hardware — ArmCanSystem hardcodes NUM_JOINTS=6 and would fail with
           "Expected 6 joints, got 7"; the JawGripperStub component below
           covers that case instead. -->
      <xacro:if value="${('$(arg end_effector)' == 'jaw') and (('$(arg sim)' == 'true') or ('$(arg use_fake_hardware)' == 'true'))}">
        <joint name="arm_jaw_gripper_finger_right_joint">
          <command_interface name="position">
            <param name="min">${-finger_limit_epsilon}</param>
            <param name="max">${finger_stroke + finger_limit_epsilon}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="arm_jaw_gripper_finger_left_joint">
          <command_interface name="position">
            <param name="min">${-finger_stroke - finger_limit_epsilon}</param>
            <param name="max">${finger_limit_epsilon}</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>
    </ros2_control>

    <!-- There is no gripper motor on the real arm yet, but both finger joints
         must still report state: without it joint_state_broadcaster never
         publishes them, the planning scene monitor sees an incomplete robot
         state, and move_group/Servo silently refuse to move. GenericSystem
         echoes commands back as state, so both joints exist for MoveIt while
         nothing physical moves. Replace with the real gripper hardware plugin
         once the motor is wired up. -->
    <xacro:if value="${('$(arg end_effector)' == 'jaw') and ('$(arg sim)' == 'false') and ('$(arg use_fake_hardware)' == 'false')}">
      <ros2_control name="JawGripperStub" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="arm_jaw_gripper_finger_right_joint">
          <command_interface name="position">
            <param name="min">0</param>
            <param name="max">${finger_stroke}</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
        <joint name="arm_jaw_gripper_finger_left_joint">
          <command_interface name="position">
            <param name="min">${-finger_stroke}</param>
            <param name="max">0</param>
          </command_interface>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>

    <xacro:if value="$(arg sim)">
      <xacro:if value="$(arg standalone_gz_plugin)">
        <gazebo>
          <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find arm_sim)/config/ros2_controllers.yaml</parameters>
          </plugin>
        </gazebo>
      </xacro:if>

      <gazebo reference="arm_mount_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_base_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_shoulder_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_forearm_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_wrist_1_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_wrist_2_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <gazebo reference="arm_end_effector_link">
        <visual>
          <material>
            <ambient>0.7 0.7 0.7 1.0</ambient>
            <diffuse>0.7 0.7 0.7 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
      </gazebo>

      <xacro:if value="${'$(arg end_effector)' == 'jaw'}">
        <gazebo reference="arm_jaw_gripper_finger_right_link">
          <visual>
            <material>
              <ambient>0.7 0.7 0.7 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
              <specular>0.3 0.3 0.3 1.0</specular>
            </material>
          </visual>
          <!-- Distinct bitmasks (0x01/0x02) exclude only this pair from
               colliding with each other; both keep the default 0xff
               against everything else (grasped object, environment). -->
          <collision>
            <surface>
              <contact>
                <collide_bitmask>0x01</collide_bitmask>
              </contact>
            </surface>
          </collision>
        </gazebo>

        <gazebo reference="arm_jaw_gripper_finger_left_link">
          <visual>
            <material>
              <ambient>0.7 0.7 0.7 1.0</ambient>
              <diffuse>0.7 0.7 0.7 1.0</diffuse>
              <specular>0.3 0.3 0.3 1.0</specular>
            </material>
          </visual>
          <!-- See arm_jaw_gripper_finger_right_link above: excludes this
               pair from each other (0x01 & 0x02 = 0) only. -->
          <collision>
            <surface>
              <contact>
                <collide_bitmask>0x02</collide_bitmask>
              </contact>
            </surface>
          </collision>
        </gazebo>
      </xacro:if>

      <xacro:if value="$(arg camera)">
      <gazebo reference="arm_camera_link">
        <sensor name="arm_camera" type="camera">
          <!-- This is the pose gz-sim actually renders from, separate
               from, and NOT driven by, arm_camera_optical_joint's TF chain
               (that joint only labels frame_id for ROS consumers via
               optical_frame_id below; editing its rpy alone was verified,
               via repeated live-captured /camera/image_raw frames, to have
               zero effect on the rendered image). X was the same stale
               0.045 (old 60mm box) bug as arm_camera_optical_joint had;
               fixed to 0.0175 (current box half-extent). Roll=pi added
               here to fix the confirmed 180 deg upside-down image. -->
          <pose>0.0175 0 0 3.14159265 0 0</pose>
          <camera>
            <optical_frame_id>arm_camera_optical_frame</optical_frame_id>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>15</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>arm_camera/image_raw</topic>
        </sensor>
      </gazebo>
      </xacro:if>
    </xacro:if>

  </xacro:macro>
</robot>
